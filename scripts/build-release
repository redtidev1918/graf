#!/usr/bin/env bash
set -euo pipefail

rm -rf dist/release .goreleaser-dist && mkdir -p dist/release
npm ci
npm test
npm run typecheck
npm run build
go test ./...
cp dist/worker.mjs dist/release/worker.mjs
tool_dir="$(mktemp -d)"
curl -fsSL "https://github.com/goreleaser/goreleaser/releases/download/v2.18.1/goreleaser_Linux_x86_64.tar.gz" | tar -xz -C "$tool_dir" goreleaser
GORELEASER_CURRENT_TAG="v$RELEASE_VERSION" "$tool_dir/goreleaser" release --clean --snapshot --dist .goreleaser-dist
cp .goreleaser-dist/grafctl_* dist/release/
cp .goreleaser-dist/checksums.txt dist/release/checksums.txt
